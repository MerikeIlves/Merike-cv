/* Kogu lehe põhistiil */
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    padding: 40px 20px;
    background: #f4f4f4;
    color: #111111;
    font-family: Arial, sans-serif;
    font-size: 12px;
}

/* CV valge leht */
.cv {
    width: 100%;
    max-width: 1100px;
    min-height: 760px;
    margin: 0 auto;
    padding: 35px;
    background: white;
}

/* Pealkiri */
.page-title {
    margin: 0 0 20px;
    text-align: center;
    font-size: 20px;
    font-weight: normal;
}

/* Nimi, kontaktid ja foto */
.profile {
    display: flex;
    align-items: flex-start;
    gap: 35px;
    margin-bottom: 25px;
}

.profile-info {
    width: 320px;
    max-width: 100%;
}

.intro,
.contact {
    padding: 8px;
    background: #e9e6da;
    margin-bottom: 10px;
}

.intro h2 {
    margin: 0 0 5px;
    font-size: 14px;
}

.intro p,
.contact p {
    margin: 3px 0;
}

.profile-photo {
    width: 180px;
    height: 180px;
    object-fit: cover;
    display: block;
}

/* CV jaotised */
.cv-section {
    margin-bottom: 20px;
}

.cv-section h2 {
    color: #101fbc;
    font-size: 15px;
    margin: 0 0 8px;
}

.cv-section p {
    margin: 3px 0;
}

/* Sotsiaalmeedia ikoonid */
.socials {
    display: flex;
    gap: 15px;
    margin-top: 25px;
}

.socials a {
    color: black;
    font-size: 22px;
    font-weight: bold;
    text-decoration: none;
}

/* Mobiilivaade */
@media (max-width: 480px) {
    body {
        padding: 0;
        font-size: 12px;
    }

    .cv {
        min-height: 100vh;
        padding: 25px 18px;
    }

    .page-title {
        margin-bottom: 20px;
        font-size: 18px;
    }

    .profile {
        gap: 12px;
        margin-bottom: 25px;
    }

    .profile-info {
        flex: 1;
        min-width: 0;
    }

    .profile-photo {
        width: 100px;
        height: 100px;
        flex-shrink: 0;
    }

    .intro,
    .contact {
        padding: 6px;
        overflow-wrap: anywhere;
    }

    .intro h2 {
        font-size: 12px;
    }

    .cv-section h2 {
        font-size: 14px;
    }
}
.karusell {
  text-align: center;
  margin: 20px auto;
}

#karuselli-pilt {
  width: 300px;
  max-width: 100%;
  height: 220px;
  object-fit: cover;
  border-radius: 12px;
  cursor: pointer;
  transition: opacity 0.3s ease;
}

#karuselli-pilt:hover {
  opacity: 0.8;
}